# RecetIA — Backend · variables de entorno
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repo.

ENVIRONMENT=development

# Base de datos — dev: SQLite (archivo local); prod: PostgreSQL
# Ej. prod: postgresql+psycopg://usuario:password@host:5432/recetia
DATABASE_URL=sqlite:///./recetia.db

# JWT / Auth — OBLIGATORIO en producción (la app no arranca con el default de dev
# si ENVIRONMENT != development). Genera uno largo (>=32 bytes) y aleatorio:
# Ej.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — dominios permitidos (separados por comas). Dev: "*". Prod: dominios reales.
# Ej.: CORS_ORIGINS=https://app.recetia.mx,https://admin.recetia.mx
CORS_ORIGINS=*

# Fase 5 — OCR de ticket (Tesseract). Ruta al binario si no está en el PATH.
# Ej. Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Fase 5 — notificaciones push (Firebase Cloud Messaging). Sin clave: envío en stub.
FCM_SERVER_KEY=

# LLM (Fase 1 — motor de recetas). NUNCA hardcodear; se lee del entorno.
# Si LLM_API_KEY queda vacío, el motor usa un stub determinista (sin costo de IA).
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
